# Firebase Web Config (Get these from Firebase Console -> Project Settings)
NEXT_PUBLIC_FIREBASE_API_KEY="your_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="hybriddesk-ai.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="hybriddesk-ai"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="hybriddesk-ai.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_app_id"

# App Check reCAPTCHA v3 Site Key (You'll need this later for Vercel deployment)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your_recaptcha_site_key"